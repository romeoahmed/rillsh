# Normalize text to LF while preserving binary files.
* text=auto eol=lf

# Fuzz seeds are exact byte inputs, including CRLF and malformed text.
fuzz/corpus/** -text

# Tree-sitter headers contain C.
*.h linguist-language=C

# Tree-sitter's generated parser follows its own C toolchain.
crates/tree-sitter-rill/src/parser.c linguist-generated
crates/tree-sitter-rill/src/grammar.json linguist-generated
crates/tree-sitter-rill/src/node-types.json linguist-generated
crates/tree-sitter-rill/src/tree_sitter/* linguist-generated
