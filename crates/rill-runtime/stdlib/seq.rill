import "std:core" as core
let {Option, Control, some, ..} = core

enum CloseReason {Exhausted, Closed, Cutoff, Failed {error}, Cancelled}

## Create a scoped producer with acquire, step and release callbacks.
fn produce protocol = __stream ["produce", protocol]

fn length items = __pure ["length", items]

fn concat a b = __pure ["concat", a, b]

fn reverse items = __pure ["reverse", items]

fn take count items =
  if __pure ["is_stream", items] then __stream ["take", count, items]
  else __pure ["take", count, items]

fn drop count items =
  if __pure ["is_stream", items] then __stream ["drop", count, items]
  else __pure ["drop", count, items]

## Accumulate items from left to right.
fn fold step initial items =
  if __pure ["is_stream", items] then
    __stream ["fold", { [acc, item] => step acc item }, initial, items]
  else match items of {
    [] => initial,
    [head, ..tail] => fold step (step initial head) tail
  }

fn each effect items =
  if __pure ["is_stream", items] then __stream ["each", effect, items]
  else match items of {
    [] => (),
    [head, ..tail] => do {
      effect head
      each effect tail
    }
  }

## Transform each item in order; Lists are eager and Streams are lazy.
fn map transform items =
  if __pure ["is_stream", items] then __stream ["map", transform, items]
  else do {
    fn loop rest output = match rest of {
      [] => __pure ["unroll", output],
      [head, ..tail] => loop tail [transform head, output]
    }
    loop items []
  }

## Flatten callback results in order: Lists require Lists; Streams accept either category.
fn flat_map transform values =
  if __pure ["is_stream", values] then __stream ["flat_map", transform, values]
  else do {
    fn prepend output rest = match rest of {
      [] => output,
      [head, ..tail] => prepend [head, output] tail,
      _ => core.raise (core.error "TypeError" "List flat_map callback must return List")
    }
    let output = fold { acc item =>
      prepend acc (transform item)
    } [] values
    __pure ["unroll", output]
  }

## Keep items whose predicate returns true, preserving their order.
fn filter predicate items =
  if __pure ["is_stream", items] then __stream ["filter", predicate, items]
  else do {
    fn loop rest output = match rest of {
      [] => __pure ["unroll", output],
      [head, ..tail] =>
        if predicate head then loop tail [head, output] else loop tail output
    }
    loop items []
  }

fn sum items = do {
  fn step acc value = match acc of {
    Option.None => some (__pure ["number", value]),
    Option.Some {value: total} => some (total + value)
  }
  match fold step Option.None items of {
    Option.None => 0,
    Option.Some {value} => value
  }
}

fn merge inputs = __stream ["merge", inputs]

fn zip inputs = __stream ["zip", inputs]

fn chunks value = __stream ["chunks", value]

fn collect_with options input = __stream ["collect", options, input]

fn collect_bytes_with options input = __stream ["collect_bytes", options, input]

fn close input = __stream ["close", input]

fn sort_by_with options key items = do {
  let items =
    if __pure ["is_stream", items] then collect_with options items else items
  let budget = __pure ["sort_input", options, items]
  let decorated = map { value =>
    [__pure ["sort_key", budget, key value], value]
  } items
  __pure ["sort", decorated]
}

let sort_by = sort_by_with {}

let collect = collect_with {}

let collect_bytes = collect_bytes_with {}

## Accumulate until Control.Stop; close any unconsumed stream input.
fn fold_until step initial items =
  if __pure ["is_stream", items] then
    __stream [
      "fold_until",
      { [acc, item] => match step acc item of {
        Control.Continue {value} => [false, value],
        Control.Stop {value} => [true, value]
      } },
      initial,
      items
    ]
  else match items of {
    [] => initial,
    [head, ..tail] => match step initial head of {
      Control.Continue {value} => fold_until step value tail,
      Control.Stop {value} => value
    }
  }

fn find predicate items = fold_until { _ item =>
  if predicate item then Control.Stop {value: some item}
  else Control.Continue {value: Option.None}
} Option.None items

fn any predicate items = fold_until { _ item =>
  if predicate item then Control.Stop {value: true}
  else Control.Continue {value: false}
} false items

fn all predicate items = fold_until { _ item =>
  if predicate item then Control.Continue {value: true}
  else Control.Stop {value: false}
} true items

fn filter_map transform items =
  if __pure ["is_stream", items] then
    items
      |> map transform
      |> filter { value => match value of {
        Option.Some {value: _} => true,
        Option.None => false
      } }
      |> map { (Option.Some {value}) => value }
  else do {
    fn loop rest output = match rest of {
      [] => __pure ["unroll", output],
      [head, ..tail] => match transform head of {
        Option.Some {value} => loop tail [value, output],
        Option.None => loop tail output
      }
    }
    loop items []
  }

fn items values = __stream ["items", values]

fn unfold step initial = __stream [
  "unfold",
  { state => match step state of {
    Option.None => [],
    Option.Some {value: [item, next]} => [item, next]
  } },
  initial
]

fn range start end = unfold { n =>
  if n < end then some [n, n + 1] else Option.None
} (__pure ["range_start", start, end])

fn aggregate operation key values = do {
  let values = if __pure ["is_stream", values] then collect values else values
  let pairs = map { value => [__pure ["aggregation_key", key value], value] } values
  __pure [operation, pairs]
}

## Group a finite sequence by String keys, preserving first-key and item order.
fn group_by key values = aggregate "group" key values

## Count a finite sequence by String keys, preserving first-key order.
fn count_by key values = aggregate "count_by" key values

## Keep the first item for each String key in a finite sequence.
fn unique_by key values = aggregate "unique" key values

export {
  CloseReason,
  produce,
  length,
  concat,
  reverse,
  take,
  drop,
  fold,
  fold_until,
  each,
  map,
  filter,
  flat_map,
  filter_map,
  find,
  any,
  all,
  sum,
  group_by,
  count_by,
  unique_by,
  sort_by,
  sort_by_with,
  merge,
  zip,
  chunks,
  items,
  unfold,
  range,
  collect,
  collect_with,
  collect_bytes,
  collect_bytes_with,
  close
}
