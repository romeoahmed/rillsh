enum Option {None, Some {value}}

enum Result {Ok {value}, Err {error}}

enum Control {Continue {value}, Stop {value}}

struct Error {kind, message, span, notes}

fn some value = Option.Some {value}

fn ok value = Result.Ok {value}

fn err error = Result.Err {error}

fn error kind message = Error {kind, message, span: null, notes: []}

fn identity value = value

fn compose f g value = f (g value)

fn add a b = a + b

fn subtract a b = a - b

fn multiply a b = a * b

fn divide a b = a / b

fn equal a b = a == b

fn less a b = a < b

fn div a b = __pure ["div", a, b]

fn rem a b = __pure ["rem", a, b]

fn int value = __pure ["int", value]

fn float value = __pure ["float", value]

fn text value = __pure ["text", value]

fn record pairs = __pure ["record", pairs]

fn extend fields base = __pure ["extend", fields, base]

fn to_record value = __pure ["to_record", value]

fn lookup key fields = match __pure ["lookup", key, fields] of {
  [value] => some value,
  [] => Option.None
}

fn entries fields = __pure ["entries", fields]

export {
  Option,
  Result,
  Control,
  Error,
  some,
  ok,
  err,
  error,
  attempt,
  raise,
  identity,
  compose,
  add,
  subtract,
  multiply,
  divide,
  equal,
  less,
  div,
  rem,
  int,
  float,
  text,
  record,
  extend,
  to_record,
  lookup,
  entries,
  bytes,
  path
}
