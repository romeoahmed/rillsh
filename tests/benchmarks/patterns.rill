fn loop [remaining, total] =
  if remaining == 0 then total else loop [remaining - 1, total + 1]

fn unit () = 1

fn invoke remaining total =
  if remaining == 0 then total else invoke (remaining - 1) (total + unit ())

if loop [200000, 0] == 200000 and invoke 200000 0 == 200000 then ()
else raise (error "Benchmark" "parameter pattern result")
