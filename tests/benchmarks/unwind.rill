fn chain(n, source) => if n == 0 then source else chain(n - 1, map(identity, source))
do {
  let earlier = chunks(bytes([]));
  let outcome = attempt(fn() => do {
    let abandoned = chain(8192, earlier);
    raise(error("Benchmark", "unwind"))
  });
  match outcome {
    Result.Err {error} => if error.kind == "Benchmark" then () else exit(42),
    _ => exit(42)
  }
}
